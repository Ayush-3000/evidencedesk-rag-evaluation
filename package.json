{
  "name": "evidencedesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "check": "tsc -p web/tsconfig.json --noEmit",
    "db": "node db/server.mjs",
    "format:check": "prettier --check web/src web/vite.config.ts db/server.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "lucide-react": "^1.50.0",
    "motion": "^14.0.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.16 <25"
  }
}
