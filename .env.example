# Example only: the launcher creates random local tokens in ignored runtime/local.env.
EVIDENCE_MODE=demo
EVIDENCE_PORT=8090
EVIDENCE_DB_URL=http://127.0.0.1:8091
EVIDENCE_DB_TOKEN=replace-with-a-random-token-at-least-32-characters
EVIDENCE_INTEGRATION_TOKEN=replace-with-another-random-token-at-least-32-characters
EVIDENCE_EMBEDDINGS=fastembed
EVIDENCE_DRAFTER=extractive
# Optional external generation requires explicit configuration:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# DATABASE_URL=postgresql://evidence:password@postgres:5432/evidence

